{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "strict": true,
    "types": [
      "vite/client"
    ],
    "moduleResolution": "Bundler",
    "noEmit": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/*.ts"
  ]
}
